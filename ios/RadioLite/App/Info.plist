<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Radio Lite</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>仅在您按住语音 PTT 发射时，Radio Lite 才会使用麦克风。</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Radio Lite 需要通过局域网或 Tailscale 连接远程电台服务器。</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>xyz.992218.radio-lite.adif</string>
            <key>UTTypeDescription</key>
            <string>Amateur Data Interchange Format log</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.plain-text</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>adi</string>
                    <string>adif</string>
                </array>
                <key>public.mime-type</key>
                <array>
                    <string>application/adif</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
