.fail

# The TCP listener is reachable only from the private Compose network. It is
# intentionally not published on the Debian host.
load-module module-native-protocol-tcp listen=0.0.0.0 port=4713 auth-anonymous=1

# TX-5DR writes transmit audio to this sink and reads the sink monitor as its
# receiver input. This gives the dummy stack a real full-duplex RtAudio path
# without requiring /dev/snd on the host.
load-module module-null-sink sink_name=tx5dr_dummy_output format=s16le rate=48000 channels=1 sink_properties=device.description=TX5DR_Dummy_Output

set-default-sink tx5dr_dummy_output
set-default-source tx5dr_dummy_output.monitor
