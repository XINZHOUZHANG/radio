+
+describe('MobilePairingCodeStore', () => {
+  it('creates a six-digit single-use code with the mobile TTL', () => {
+    const store = new MobilePairingCodeStore();
+    const created = store.create('admin-1', 1_000);
+
+    expect(created.code).toMatch(/^\d{6}$/);
+    expect(created.expiresAt).toBe(1_000 + MOBILE_PAIRING_CODE_TTL_MS);
+    expect(store.consume(created.code, 2_000)?.issuerTokenId).toBe('admin-1');
+    expect(store.consume(created.code, 2_000)).toBeNull();
+  });
+
+  it('consumes expired codes without allowing a later retry', () => {
+    const store = new MobilePairingCodeStore();
+    const created = store.create('admin-1', 1_000);
+
+    expect(store.consume(created.code, created.expiresAt)).toBeNull();
+    expect(store.consume(created.code, 1_001)).toBeNull();
+  });
+
+  it('rejects malformed codes before lookup', () => {
+    const store = new MobilePairingCodeStore();
+    expect(store.consume('12345')).toBeNull();
+    expect(store.consume('abcdef')).toBeNull();
+  });
+
+  it('enforces per-issuer and global outstanding-code bounds', () => {
+    const perIssuerStore = new MobilePairingCodeStore();
+    for (let index = 0; index < MAX_MOBILE_PAIRING_CODES_PER_ISSUER; index += 1) {
+      perIssuerStore.create('admin-1', 1_000);
+    }
+    expect(() => perIssuerStore.create('admin-1', 1_000)).toThrow(MobilePairingCodeCapacityError);
+
+    const globalStore = new MobilePairingCodeStore();
+    for (let index = 0; index < MAX_MOBILE_PAIRING_CODES_GLOBAL; index += 1) {
+      globalStore.create(`admin-${index}`, 1_000);
+    }
+    expect(() => globalStore.create('one-more-admin', 1_000)).toThrow(MobilePairingCodeCapacityError);
+  });
+
+  it('prunes expired records and clears all outstanding codes', () => {
+    const store = new MobilePairingCodeStore();
+    const created = store.create('admin-1', 1_000);
+    for (let index = 1; index < MAX_MOBILE_PAIRING_CODES_PER_ISSUER; index += 1) {
+      store.create('admin-1', 1_000);
+    }
+
+    expect(() => store.create('admin-1', 1_000 + MOBILE_PAIRING_CODE_TTL_MS)).not.toThrow();
+    store.clear();
+    expect(store.consume(created.code)).toBeNull();
+  });
+});
