+
+export const MOBILE_PAIRING_CODE_TTL_MS = 120_000;
+export const MAX_MOBILE_PAIRING_CODES_PER_ISSUER = 3;
+export const MAX_MOBILE_PAIRING_CODES_GLOBAL = 24;
+
+interface MobilePairingCodeRecord {
+  issuerTokenId: string;
+  createdAt: number;
+  expiresAt: number;
+}
+
+export interface CreatedMobilePairingCode {
+  code: string;
+  expiresAt: number;
+}
+
+export class MobilePairingCodeCapacityError extends Error {
+  constructor() {
+    super('Too many outstanding mobile pairing codes');
+    this.name = 'MobilePairingCodeCapacityError';
+  }
+}
+
+/**
+ * Short, single-use codes for native-app pairing. Six decimal digits are only
+ * safe in combination with the short TTL, strict capacity limits and the
+ * per-IP exchange limiter installed by authRoutes.
+ */
+export class MobilePairingCodeStore {
+  private readonly records = new Map<string, MobilePairingCodeRecord>();
+
+  create(issuerTokenId: string, now = Date.now()): CreatedMobilePairingCode {
+    this.pruneExpired(now);
+    let issuerCount = 0;
+    for (const record of this.records.values()) {
+      if (record.issuerTokenId === issuerTokenId) issuerCount += 1;
+    }
+    if (
+      issuerCount >= MAX_MOBILE_PAIRING_CODES_PER_ISSUER
+      || this.records.size >= MAX_MOBILE_PAIRING_CODES_GLOBAL
+    ) {
+      throw new MobilePairingCodeCapacityError();
+    }
+
+    for (let attempt = 0; attempt < 32; attempt += 1) {
+      const code = randomInt(0, 1_000_000).toString().padStart(6, '0');
+      const digest = this.digest(code);
+      if (this.records.has(digest)) continue;
+      const expiresAt = now + MOBILE_PAIRING_CODE_TTL_MS;
+      this.records.set(digest, { issuerTokenId, createdAt: now, expiresAt });
+      return { code, expiresAt };
+    }
+    throw new MobilePairingCodeCapacityError();
+  }
+
+  consume(code: string, now = Date.now()): MobilePairingCodeRecord | null {
+    const digest = this.digest(code);
+    const record = this.records.get(digest);
+    if (!record) return null;
+    this.records.delete(digest);
+    if (record.expiresAt <= now) return null;
+    return record;
+  }
+
+  clear(): void {
+    this.records.clear();
+  }
+
+  private pruneExpired(now: number): void {
+    for (const [digest, record] of this.records) {
+      if (record.expiresAt <= now) this.records.delete(digest);
+    }
+  }
+
+  private digest(code: string): string {
+    return createHash('sha256').update(code).digest('hex');
+  }
+}
